\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Tuning the baseline. Mean stratified 5-fold cross-validation accuracy of logistic regression inside the $50{,}000$ training images, averaged over three fold-shuffle seeds; the fold standard error is the standard deviation over the five folds divided by $\sqrt  {5}$. $C = 0.1$ is selected in every repeat; $C = 1$ is within about one standard error of it.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:cv}{{1}{4}{Tuning the baseline. Mean stratified 5-fold cross-validation accuracy of logistic regression inside the $50{,}000$ training images, averaged over three fold-shuffle seeds; the fold standard error is the standard deviation over the five folds divided by $\sqrt {5}$. $C = 0.1$ is selected in every repeat; $C = 1$ is within about one standard error of it}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Baseline result. Logistic regression ($C = 0.1$) on the $10{,}000$ validation images, at three weight precisions. Brackets are 95\% bootstrap intervals ($2{,}000$ resamples of the validation images). $L$ is the exact Lipschitz constant of the logits (spectral norm of the weights). \texttt  {int8}{} matches \texttt  {fp32}{}; \texttt  {int4}{} costs about half a point of clean accuracy and two points of FGSM accuracy at $\epsilon = 0.05$.}}{4}{table.2}\protected@file@percent }
\newlabel{tab:baseline}{{2}{4}{Baseline result. Logistic regression ($C = 0.1$) on the $10{,}000$ validation images, at three weight precisions. Brackets are 95\% bootstrap intervals ($2{,}000$ resamples of the validation images). $L$ is the exact Lipschitz constant of the logits (spectral norm of the weights). \ieight {} matches \fp {}; \ifour {} costs about half a point of clean accuracy and two points of FGSM accuracy at $\epsilon = 0.05$}{table.2}{}}
