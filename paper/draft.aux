\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Effect of \texttt  {int4}{} quantization on FGSM accuracy: \texttt  {int4}{} minus \texttt  {fp32}{}, in percentage points, on the validation split. Circles are individual seeds (the same trained network before and after rounding), bars are their means, and the diamond is the baseline (one deterministic model). \texttt  {int4}{} hurts the unregularized models at $\epsilon = 0.05$ and appears to help the weight-decayed MLPs at larger $\epsilon $.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:diff}{{2}{6}{Effect of \ifour {} quantization on FGSM accuracy: \ifour {} minus \fp {}, in percentage points, on the validation split. Circles are individual seeds (the same trained network before and after rounding), bars are their means, and the diamond is the baseline (one deterministic model). \ifour {} hurts the unregularized models at $\epsilon = 0.05$ and appears to help the weight-decayed MLPs at larger $\epsilon $}{figure.2}{}}
