\@writefile{toc}{\contentsline {paragraph}{\texttt  {int8}{} changes nothing measurable.}{4}{section*.16}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{\texttt  {int4}{} barely moves the bound.}{4}{section*.17}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{\texttt  {int4}{} costs a little clean accuracy.}{4}{section*.18}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The effect of \texttt  {int4}{} on FGSM accuracy depends on weight decay.}{4}{section*.19}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces MLP results on the validation split, mean $\pm $ standard deviation over three seeds. Weight decay lowers both Lipschitz bounds and raises FGSM accuracy at $\epsilon = 0.1$; \texttt  {int8}{} rows match their \texttt  {fp32}{} rows; \texttt  {int4}{} rows differ by a few points in FGSM accuracy, in a direction that depends on weight decay.}}{5}{table.3}\protected@file@percent }
\newlabel{tab:mlp}{{3}{5}{MLP results on the validation split, mean $\pm $ standard deviation over three seeds. Weight decay lowers both Lipschitz bounds and raises FGSM accuracy at $\epsilon = 0.1$; \ieight {} rows match their \fp {} rows; \ifour {} rows differ by a few points in FGSM accuracy, in a direction that depends on weight decay}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Key figure (first version). FGSM accuracy at $\epsilon = 0.1$ against the Lipschitz upper bound, on the validation split. Points are means over three seeds and bars are $\pm 1$ standard deviation; the baseline has no seed spread. Within the MLP family a smaller bound goes with higher robust accuracy, and the three precisions of each model sit almost on top of each other. The bound does not rank models across families: logistic regression has a small bound and the lowest robust accuracy.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:key}{{1}{5}{Key figure (first version). FGSM accuracy at $\epsilon = 0.1$ against the Lipschitz upper bound, on the validation split. Points are means over three seeds and bars are $\pm 1$ standard deviation; the baseline has no seed spread. Within the MLP family a smaller bound goes with higher robust accuracy, and the three precisions of each model sit almost on top of each other. The bound does not rank models across families: logistic regression has a small bound and the lowest robust accuracy}{figure.1}{}}
